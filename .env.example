# Copy to .env and fill in real values. See lib/env.ts for validation rules —
# the app refuses to boot (instrumentation.ts) if a required var is missing
# or malformed.

NODE_ENV=development

# ── Required ─────────────────────────────────────────────────────────────────
# Postgres connection string. In production it is set by deploy/docker-compose.yml
# (see deploy/README.md); local dev can use docker-compose.db.yml:
#   postgresql://sleepsheet:sleepsheet@localhost:5433/sleepsheet
DATABASE_URL="postgresql://sleepsheet:sleepsheet@localhost:5433/sleepsheet"
# Signs/verifies session JWTs. Generate with: openssl rand -base64 48
JWT_SECRET=""

# ── Auth ─────────────────────────────────────────────────────────────────────
# This email is always granted the ADMIN role, regardless of its `role` column.
SUPER_ADMIN_EMAIL=""

# ── URLs / CORS ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated extra origins allowed to make credentialed requests to
# /api/** (see app/api/[[...route]]/route.ts). NEXT_PUBLIC_APP_URL is always
# trusted; add others here only if a separate frontend domain calls this API.
TRUSTED_ORIGINS="http://localhost:3000"

# ── Meta Pixel / Conversions API (optional — features no-op when unset) ─────
# Runtime values (mappings, per-pixel enable/debug) live in the admin panel:
# Dashboard → Settings → Meta Pixel. These are fallbacks used when the admin
# panel hasn't set a value.
META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# ── SEO / analytics (optional) ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GOOGLE_VERIFICATION=""
NEXT_PUBLIC_BING_VERIFICATION=""
NEXT_PUBLIC_YANDEX_VERIFICATION=""
GA4_PROPERTY_ID=""

# ── n8n order alerts (optional — no-op when unset) ──────────────────────────
# Webhook (Webhook trigger node URL) that fires on every new website order.
# Wire it to n8n's Telegram node to get realtime order alerts on Telegram.
N8N_ORDER_WEBHOOK_URL=""
N8N_ERROR_WEBHOOK_URL=""
# Webhook URL for direct product cache sync from /dashboard/images
N8N_PRODUCT_CACHE_WEBHOOK_URL=""

# ── Settings engine ─────────────────────────────────────────────────────────
# Encrypts credentials stored in site_settings (bKash, Steadfast, Cloudinary,
# Google Sheets, AI key). Generate with: openssl rand -base64 32
# Keep a copy in the password manager — losing it means re-entering every credential.
SETTINGS_ENCRYPTION_KEY=""
