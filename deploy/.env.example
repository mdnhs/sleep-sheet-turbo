# Copy to deploy/.env on the VPS and fill in (never commit the real one).
# The app reads every variable in this file at runtime; NEXT_PUBLIC_* values
# are also baked into the client bundle at build time.

# ── Database (the stack's own Postgres) ────────────────────────────────────
POSTGRES_USER=sleepsheet
# Long random value, e.g. `openssl rand -base64 32 | tr -d '/+='`
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sleepsheet
# DATABASE_URL is derived from the three values above in docker-compose.yml.

# Host ports, bound to 127.0.0.1 only. Change if n8n or anything else
# already uses them.
APP_HOST_PORT=3000
POSTGRES_HOST_PORT=5432

# ── Scheduled jobs ─────────────────────────────────────────────────────────
# Bearer token the cron container sends to /api/audiences/cron-sync.
CRON_SECRET=

# ── App ────────────────────────────────────────────────────────────────────
# Everything else the app needs (JWT_SECRET, NEXT_PUBLIC_APP_URL,
# Cloudinary, bKash, Steadfast, GTM, GA4, N8N_ORDER_WEBHOOK_URL, …) —
# copy the Production values from Vercel (`vercel env pull`), minus
# DATABASE_URL and any VERCEL_* variables. See ../.env.example for the list.
